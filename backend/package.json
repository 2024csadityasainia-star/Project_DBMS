{
  "name": "nutritrack-dbms-backend",
  "version": "1.0.0",
  "description": "NutriTrack nutrition logging DBMS project with MySQL and Express.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "db:init": "mysql -u root -p < ../database/schema.sql",
    "db:seed": "mysql -u root -p nutritrack_db < ../database/seed.sql"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mysql2": "^3.11.5"
  }
}
